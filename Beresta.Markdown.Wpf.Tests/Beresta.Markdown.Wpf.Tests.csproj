<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net7.0-windows;net8.0-windows;net9.0-windows;net10.0-windows</TargetFrameworks>
		<RootNamespace>Beresta.Markdown.Wpf.Tests</RootNamespace>
		<IsTestProject>true</IsTestProject>
		<IsPackable>false</IsPackable>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="FluentAssertions" Version="6.12.1" />
		<!-- BYDESIGN: Microsoft.NET.Test.Sdk новее 17.11 не поддерживает .NET 7 — под него своя версия. -->
		<PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.0" Condition="'$(TargetFramework)' != 'net7.0-windows'" />
		<PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" Condition="'$(TargetFramework)' == 'net7.0-windows'" />
		<PackageReference Include="xunit" Version="2.5.3" />
		<PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Beresta.Markdown.Wpf\Beresta.Markdown.Wpf.csproj" />
		<ProjectReference Include="..\Beresta.Markdown.Wpf.Editor\Beresta.Markdown.Wpf.Editor.csproj" />
	</ItemGroup>

	<ItemGroup>
		<None
			Include="..\Beresta.Markdown.Wpf\Docs\Beresta.Markdown.Wpf.ru.xml"
			Link="Docs\Beresta.Markdown.Wpf.ru.xml"
			CopyToOutputDirectory="PreserveNewest" />
		<None
			Include="..\Beresta.Markdown.Wpf.Editor\Docs\Beresta.Markdown.Wpf.Editor.ru.xml"
			Link="Docs\Beresta.Markdown.Wpf.Editor.ru.xml"
			CopyToOutputDirectory="PreserveNewest" />
		<None
			Include="..\Beresta.Markdown.Wpf\Themes\Generic.xaml"
			Link="Themes\Generic.xaml"
			CopyToOutputDirectory="PreserveNewest" />
	</ItemGroup>

	<ItemGroup>
		<Using Include="Xunit" />
		<Using Include="FluentAssertions" />
	</ItemGroup>

</Project>