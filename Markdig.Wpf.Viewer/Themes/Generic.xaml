<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:b="clr-namespace:MarkdigWpfViewer.Behaviors"
                    xmlns:s="clr-namespace:MarkdigWpfViewer.Styling"
                    xmlns:vm="clr-namespace:MarkdigWpfViewer.ViewModels"
                    xmlns:p="clr-namespace:MarkdigWpfViewer.Presenters"
                    xmlns:local="clr-namespace:MarkdigWpfViewer"
                    xmlns:mdx="clr-namespace:MarkdigWpfViewer.Extensions"
                    xmlns:kit="clr-namespace:MarkdigWpfViewer.Kit"
                    xmlns:sel="clr-namespace:MarkdigWpfViewer.Selection"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <s:MarkdownTemplateSelector x:Key="Md.TemplateSelector" />

    <!-- ======== Md.Paragraph ======== -->
    <!-- Md.Paragraph.FontFamily и Md.Paragraph.Foreground не заданы: текст берёт их у приложения -->
    <sys:Double x:Key="Md.Paragraph.FontSize">14</sys:Double>
    <Brush x:Key="Md.Paragraph.LinkForeground">Blue</Brush>

    <!-- ======== Начертания ======== -->
    <Style x:Key="Md.Strong.Style" TargetType="{x:Type Span}">
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="Md.Emphasis.Style" TargetType="{x:Type Span}">
        <Setter Property="FontStyle" Value="Italic" />
    </Style>
    <Style x:Key="Md.Strike.Style" TargetType="{x:Type Span}">
        <Setter Property="TextDecorations" Value="Strikethrough" />
    </Style>
    <Style x:Key="Md.Link.Style" TargetType="{x:Type Hyperlink}" />

    <!-- ======== Маркер, вставка, название произведения, сокращение ======== -->
    <SolidColorBrush x:Key="Md.Marked.Background" Color="#FFE066" Opacity="0.6" />
    <Brush x:Key="Md.Abbreviation.UnderlineBrush">Gray</Brush>
    <Style x:Key="Md.Marked.Style" TargetType="{x:Type Span}">
        <Setter Property="Background" Value="{DynamicResource Md.Marked.Background}" />
    </Style>
    <Style x:Key="Md.Inserted.Style" TargetType="{x:Type Span}">
        <Setter Property="TextDecorations" Value="Underline" />
    </Style>
    <Style x:Key="Md.Cite.Style" TargetType="{x:Type Span}">
        <Setter Property="FontStyle" Value="Italic" />
    </Style>
    <Style x:Key="Md.Abbreviation.Style" TargetType="{x:Type Span}">
        <Setter Property="Cursor" Value="Help" />
        <Setter Property="TextDecorations">
            <Setter.Value>
                <TextDecorationCollection>
                    <TextDecoration Location="Underline" PenOffset="1">
                        <TextDecoration.Pen>
                            <Pen Thickness="1" DashStyle="{x:Static DashStyles.Dot}" Brush="{StaticResource Md.Abbreviation.UnderlineBrush}" />
                        </TextDecoration.Pen>
                    </TextDecoration>
                </TextDecorationCollection>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ======== Md.InlineCode ======== -->
    <FontFamily x:Key="Md.InlineCode.FontFamily">Consolas</FontFamily>
    <sys:Double x:Key="Md.InlineCode.FontSize">14</sys:Double>
    <Brush x:Key="Md.InlineCode.Background">Bisque</Brush>
    <Brush x:Key="Md.InlineCode.Foreground">Brown</Brush>
    <Brush x:Key="Md.InlineCode.BorderBrush">#dadada</Brush>
    <Thickness x:Key="Md.InlineCode.BorderThickness">1</Thickness>
    <Thickness x:Key="Md.InlineCode.Padding">3,1</Thickness>
    <CornerRadius x:Key="Md.InlineCode.CornerRadius">3</CornerRadius>

    <!-- ======== Md.Kbd: клавиша <kbd> ======== -->
    <FontFamily x:Key="Md.Kbd.FontFamily">Consolas</FontFamily>
    <Brush x:Key="Md.Kbd.Foreground">#24292F</Brush>
    <Brush x:Key="Md.Kbd.Background">#F6F8FA</Brush>
    <Brush x:Key="Md.Kbd.BorderBrush">#D0D7DE</Brush>
    <Thickness x:Key="Md.Kbd.BorderThickness">1,1,1,2</Thickness>
    <Thickness x:Key="Md.Kbd.Padding">4,0</Thickness>
    <CornerRadius x:Key="Md.Kbd.CornerRadius">4</CornerRadius>

    <!-- ======== Md.Image, Md.Task, Md.Footnote ======== -->
    <Brush x:Key="Md.Image.AltForeground">Gray</Brush>
    <Thickness x:Key="Md.Task.Margin">0,0,6,0</Thickness>
    <GridLength x:Key="Md.Footnote.MarkerWidth">24</GridLength>
    <Brush x:Key="Md.Footnote.MarkerForeground">Gray</Brush>
    <sys:Double x:Key="Md.Footnote.LinkFontSize">11</sys:Double>

    <!-- ======== Md.Figure, Md.Footer ======== -->
