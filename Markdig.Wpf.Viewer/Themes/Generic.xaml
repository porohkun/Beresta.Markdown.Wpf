    <Style x:Key="Md.Callout.TitleStyle" TargetType="{x:Type p:MdTextBlock}" BasedOn="{StaticResource Md.Paragraph.Style}">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{Binding Accent, RelativeSource={RelativeSource AncestorType={x:Type p:MdCalloutPresenter}}}" />
    </Style>

    <Style x:Key="Md.Callout.DefaultTitleStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{DynamicResource Md.Paragraph.FontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource Md.Paragraph.FontSize}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{Binding Accent, RelativeSource={RelativeSource AncestorType={x:Type p:MdCalloutPresenter}}}" />
    </Style>

    <!-- Заголовок-переключатель плашки и сворачиваемого блока: без своей рамки и фона -->
    <Style x:Key="Md.Callout.HeaderStyle" TargetType="{x:Type ToggleButton}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ToggleButton}">
                    <ContentPresenter Margin="{TemplateBinding Padding}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Md.Callout.Style" TargetType="{x:Type p:MdCalloutPresenter}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type p:MdCalloutPresenter}">
                    <Border BorderBrush="{TemplateBinding Accent}"
                            BorderThickness="{DynamicResource Md.Callout.BorderThickness}"
                            Background="{DynamicResource Md.Callout.Background}"
                            CornerRadius="{DynamicResource Md.Callout.CornerRadius}"
                            Padding="{DynamicResource Md.Callout.Padding}"
                            Margin="{DynamicResource Md.Callout.Margin}">
                        <StackPanel>
                            <ToggleButton x:Name="Header"
                                          IsHitTestVisible="False"
                                          IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                          Style="{DynamicResource Md.Callout.HeaderStyle}">
                                <DockPanel>
                                    <Path DockPanel.Dock="Left"
                                          Data="{TemplateBinding Icon}"
                                          Fill="{TemplateBinding Accent}"
                                          Width="16"
                                          Height="16"
                                          Stretch="Uniform"
                                          Margin="0,0,8,0"
                                          VerticalAlignment="Center" />
                                    <Path x:Name="Chevron"
                                          DockPanel.Dock="Right"
                                          Visibility="Collapsed"
                                          Data="{DynamicResource Md.Callout.ChevronIcon}"
                                          Fill="{TemplateBinding Accent}"
                                          Width="10"
                                          Height="10"
                                          Stretch="Uniform"
                                          Margin="8,0,0,0"
                                          VerticalAlignment="Center"
                                          RenderTransformOrigin="0.5,0.5" />
                                    <Grid VerticalAlignment="Center">
                                        <p:MdTextBlock x:Name="CustomTitle"
                                                       Visibility="Collapsed"
                                                       Runs="{TemplateBinding Title}"
                                                       Style="{DynamicResource Md.Callout.TitleStyle}" />
                                        <TextBlock x:Name="DefaultTitle"
                                                   Text="{TemplateBinding DefaultTitle}"
                                                   Style="{DynamicResource Md.Callout.DefaultTitleStyle}" />
                                    </Grid>
                                </DockPanel>
                            </ToggleButton>
                            <p:MdBlocksPresenter x:Name="Body" Blocks="{TemplateBinding Blocks}" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="HasTitle" Value="True">
                            <Setter TargetName="CustomTitle" Property="Visibility" Value="Visible" />
                            <Setter TargetName="DefaultTitle" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsFoldable" Value="True">
                            <Setter TargetName="Header" Property="IsHitTestVisible" Value="True" />
                            <Setter TargetName="Chevron" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsExpanded" Value="False">
                            <Setter TargetName="Body" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="Chevron" Property="RenderTransform">
                                <Setter.Value>
                                    <RotateTransform Angle="-90" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Md.Details.SummaryStyle" TargetType="{x:Type p:MdTextBlock}" BasedOn="{StaticResource Md.Paragraph.Style}">
        <Setter Property="FontWeight" Value="SemiBold" />
