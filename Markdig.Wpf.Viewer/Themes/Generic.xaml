    <Style x:Key="Md.Table.Style" TargetType="{x:Type p:MdTablePresenter}">
        <Setter Property="FontFamily" Value="{DynamicResource Md.Paragraph.FontFamily}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type p:MdTablePresenter}">
                    <ScrollViewer VerticalScrollBarVisibility="Disabled"
                                  HorizontalScrollBarVisibility="Auto"
                                  b:NestedScroll.PassWheelToParent="True">
                        <Border BorderBrush="{DynamicResource Md.Table.BorderBrush}"
                                BorderThickness="{DynamicResource Md.Table.BorderThickness}"
                                HorizontalAlignment="Left">
                            <Grid x:Name="PART_Grid" SnapsToDevicePixels="True" />
                        </Border>
                    </ScrollViewer>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="HeaderTemplate">
            <Setter.Value>
                <DataTemplate DataType="{x:Type vm:TableCellVm}">
                    <Border BorderBrush="{DynamicResource Md.Table.BorderBrush}"
                            BorderThickness="{DynamicResource Md.Table.BorderThickness}"
                            Padding="{DynamicResource Md.Table.CellPadding}"
                            Background="{DynamicResource Md.Table.HeaderBackground}">
                        <Grid>
                            <p:MdTextBlock x:Name="Text" Runs="{Binding Inlines}" Style="{DynamicResource Md.Paragraph.Style}" />
                            <p:MdBlocksPresenter x:Name="Blocks" Blocks="{Binding Blocks}" Visibility="Collapsed" />
                        </Grid>
                    </Border>
                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding HasBlocks}" Value="True">
                            <Setter TargetName="Text" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="Blocks" Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="CellTemplate">
            <Setter.Value>
                <DataTemplate DataType="{x:Type vm:TableCellVm}">
                    <Border BorderBrush="{DynamicResource Md.Table.BorderBrush}"
                            BorderThickness="{DynamicResource Md.Table.BorderThickness}"
                            Padding="{DynamicResource Md.Table.CellPadding}">
                        <Grid>
                            <p:MdTextBlock x:Name="Text" Runs="{Binding Inlines}" Style="{DynamicResource Md.Paragraph.Style}" />
                            <p:MdBlocksPresenter x:Name="Blocks" Blocks="{Binding Blocks}" Visibility="Collapsed" />
                        </Grid>
                    </Border>
                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding HasBlocks}" Value="True">
                            <Setter TargetName="Text" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="Blocks" Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ======== Templates ======== -->
    <s:MdStyleProvider x:Key="Md.DefaultStyleProvider">

        <s:MdStyleProvider.ParagraphTemplate>
            <DataTemplate DataType="{x:Type vm:ParagraphVm}">
                <p:MdTextBlock Runs="{Binding Inlines}" Style="{DynamicResource Md.Paragraph.Style}" />
            </DataTemplate>
        </s:MdStyleProvider.ParagraphTemplate>

        <s:MdStyleProvider.HeadingTemplate>
            <DataTemplate DataType="{x:Type vm:HeadingVm}">
                <p:MdHeadingBlock Level="{Binding Level}" Runs="{Binding Inlines}"
                                  Style="{DynamicResource Md.Heading.Style}" />
            </DataTemplate>
        </s:MdStyleProvider.HeadingTemplate>

        <s:MdStyleProvider.CodeBlockTemplate>
            <DataTemplate DataType="{x:Type vm:CodeBlockVm}">
                <p:CodeBlockPresenter InfoString="{Binding InfoString}" Syntax="{Binding Syntax}" Code="{Binding Code}"
                                      IsFenced="{Binding IsFenced}" Runs="{Binding Runs}" Style="{DynamicResource Md.CodeBlock.Style}" />
            </DataTemplate>
        </s:MdStyleProvider.CodeBlockTemplate>

        <s:MdStyleProvider.QuoteTemplate>
            <DataTemplate DataType="{x:Type vm:QuoteVm}">
                <p:QuotePresenter Blocks="{Binding Blocks}" Style="{DynamicResource Md.Quote.Style}" />
            </DataTemplate>
        </s:MdStyleProvider.QuoteTemplate>

        <s:MdStyleProvider.ListTemplate>
            <DataTemplate DataType="{x:Type vm:ListVm}">
                <p:MdListPresenter ItemsSource="{Binding Items}" Style="{DynamicResource Md.List.Style}" />
            </DataTemplate>
        </s:MdStyleProvider.ListTemplate>

        <s:MdStyleProvider.TableTemplate>
            <DataTemplate DataType="{x:Type vm:TableVm}">
                <p:MdTablePresenter Table="{Binding}" Style="{DynamicResource Md.Table.Style}" />
            </DataTemplate>
        </s:MdStyleProvider.TableTemplate>

        <s:MdStyleProvider.HorizontalRuleTemplate>
            <DataTemplate DataType="{x:Type vm:ThematicBreakVm}">
                <Separator Margin="{DynamicResource Md.HorizontalRule.Margin}" />
            </DataTemplate>
        </s:MdStyleProvider.HorizontalRuleTemplate>

        <s:MdStyleProvider.BlankLineTemplate>
            <DataTemplate DataType="{x:Type vm:BlankLineVm}">
                <Border Height="{DynamicResource Md.BlankLine.Height}" Background="Transparent" />
            </DataTemplate>
        </s:MdStyleProvider.BlankLineTemplate>

        <s:MdStyleProvider.FootnoteTemplate>
            <DataTemplate DataType="{x:Type vm:FootnoteVm}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{DynamicResource Md.Footnote.MarkerWidth}" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Order, StringFormat={}{0}.}" Style="{DynamicResource Md.Footnote.MarkerStyle}" />
                    <p:MdBlocksPresenter Grid.Column="1" Blocks="{Binding Blocks}" />
                </Grid>
            </DataTemplate>
        </s:MdStyleProvider.FootnoteTemplate>

        <s:MdStyleProvider.ImageTemplate>
            <DataTemplate DataType="{x:Type vm:ImageVm}">
                <p:MdImage Image="{Binding}" Style="{DynamicResource Md.Image.Style}" />
            </DataTemplate>
        </s:MdStyleProvider.ImageTemplate>

        <s:MdStyleProvider.TaskTemplate>
            <DataTemplate DataType="{x:Type vm:TaskVm}">
                <p:MdTaskCheckBox Task="{Binding}"
                                  Focusable="False"
                                  Margin="{DynamicResource Md.Task.Margin}"
                                  Style="{DynamicResource {x:Type CheckBox}}" />
            </DataTemplate>
        </s:MdStyleProvider.TaskTemplate>

        <s:MdStyleProvider.FootnoteLinkTemplate>
            <DataTemplate DataType="{x:Type vm:FootnoteLinkVm}">
                <p:MdFootnoteLink Link="{Binding}" Style="{DynamicResource Md.FootnoteLink.Style}" />
            </DataTemplate>
        </s:MdStyleProvider.FootnoteLinkTemplate>

        <s:MdStyleProvider.FigureTemplate>
            <DataTemplate DataType="{x:Type vm:FigureVm}">
                <p:MdBlocksPresenter Blocks="{Binding Blocks}"
                                     Margin="{DynamicResource Md.Figure.Margin}"
                                     TextBlock.TextAlignment="Center" />
            </DataTemplate>
        </s:MdStyleProvider.FigureTemplate>

        <s:MdStyleProvider.FigureCaptionTemplate>
            <DataTemplate DataType="{x:Type vm:FigureCaptionVm}">
                <p:MdTextBlock Runs="{Binding Inlines}" Style="{DynamicResource Md.Figure.CaptionStyle}" />
            </DataTemplate>
        </s:MdStyleProvider.FigureCaptionTemplate>

        <s:MdStyleProvider.FooterTemplate>
            <DataTemplate DataType="{x:Type vm:FooterVm}">
                <p:MdBlocksPresenter Blocks="{Binding Blocks}" Margin="{DynamicResource Md.Footer.Margin}">
                    <p:MdBlocksPresenter.Resources>
                        <!-- Абзацы подвала — мелким текстом: свой стиль абзаца на основе общего -->
                        <Style x:Key="Md.Paragraph.Style" TargetType="{x:Type p:MdTextBlock}" BasedOn="{StaticResource Md.Paragraph.Style}">
                            <Setter Property="FontSize" Value="{DynamicResource Md.Footer.FontSize}" />
                            <Setter Property="Foreground" Value="{DynamicResource Md.Footer.Foreground}" />
                        </Style>
                    </p:MdBlocksPresenter.Resources>
                </p:MdBlocksPresenter>
            </DataTemplate>
        </s:MdStyleProvider.FooterTemplate>

        <s:MdStyleProvider.CalloutTemplate>
            <DataTemplate DataType="{x:Type vm:CalloutVm}">
                <p:MdCalloutPresenter Kind="{Binding Kind}"
                                      Title="{Binding Title}"
                                      Blocks="{Binding Blocks}"
                                      IsFoldable="{Binding IsFoldable}"
                                      IsExpanded="{Binding Path=(mdx:MdWidget.State).IsExpanded, RelativeSource={RelativeSource Self}, FallbackValue=True}"
                                      Style="{DynamicResource Md.Callout.Style}" />
            </DataTemplate>
        </s:MdStyleProvider.CalloutTemplate>

        <s:MdStyleProvider.DetailsTemplate>
            <DataTemplate DataType="{x:Type vm:DetailsVm}">
                <p:MdDetailsPresenter Summary="{Binding Summary}"
                                      Blocks="{Binding Blocks}"
                                      IsExpanded="{Binding Path=(mdx:MdWidget.State).IsExpanded, RelativeSource={RelativeSource Self}, FallbackValue=True}"
                                      Style="{DynamicResource Md.Details.Style}" />
            </DataTemplate>
        </s:MdStyleProvider.DetailsTemplate>

        <s:MdStyleProvider.DefinitionListTemplate>
            <DataTemplate DataType="{x:Type vm:DefinitionListVm}">
                <p:MdDefinitionListPresenter ItemsSource="{Binding Items}" Style="{DynamicResource Md.DefinitionList.Style}" />
            </DataTemplate>
        </s:MdStyleProvider.DefinitionListTemplate>

        <s:MdStyleProvider.AlignedTemplate>
            <DataTemplate DataType="{x:Type vm:AlignedVm}">
                <p:MdBlocksPresenter x:Name="Blocks" Blocks="{Binding Blocks}" />
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding Alignment}" Value="Left">
                        <Setter TargetName="Blocks" Property="TextBlock.TextAlignment" Value="Left" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Alignment}" Value="Center">
                        <Setter TargetName="Blocks" Property="TextBlock.TextAlignment" Value="Center" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Alignment}" Value="Right">
                        <Setter TargetName="Blocks" Property="TextBlock.TextAlignment" Value="Right" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Alignment}" Value="Justify">
                        <Setter TargetName="Blocks" Property="TextBlock.TextAlignment" Value="Justify" />
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>
        </s:MdStyleProvider.AlignedTemplate>

    </s:MdStyleProvider>

    <!-- ======== Готовые расширения: связи ======== -->
    <Style x:Key="Md.WikiLink.Style" TargetType="{x:Type Span}" />
    <Style x:Key="Md.WikiLink.Missing.Style" TargetType="{x:Type Span}">
        <Setter Property="Foreground" Value="#CF222E" />
    </Style>

    <Style x:Key="Md.Tag.Style" TargetType="{x:Type Span}">
        <Setter Property="Background" Value="#DDF4FF" />
        <Setter Property="Foreground" Value="#0969DA" />
    </Style>

    <Brush x:Key="Md.Mention.Background">#DDF4FF</Brush>
    <Brush x:Key="Md.Mention.Foreground">#0969DA</Brush>
    <Thickness x:Key="Md.Mention.Padding">4,0</Thickness>
    <CornerRadius x:Key="Md.Mention.CornerRadius">8</CornerRadius>
    <DataTemplate x:Key="Md.Mention.Template" DataType="{x:Type kit:MentionVm}">
        <Button Style="{x:Null}"
                Focusable="False"
                Cursor="Hand"
                ToolTip="{Binding Href}"
                Command="{x:Static local:MarkdownLink.ActivateCommand}"
                CommandParameter="{Binding Href}">
            <Button.Template>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border Background="{DynamicResource Md.Mention.Background}"
                            CornerRadius="{DynamicResource Md.Mention.CornerRadius}"
                            Padding="{DynamicResource Md.Mention.Padding}">
                        <TextBlock Text="{Binding DisplayName, StringFormat='@{0}'}"
                                   Foreground="{DynamicResource Md.Mention.Foreground}" />
                    </Border>
                </ControlTemplate>
            </Button.Template>
        </Button>
    </DataTemplate>

    <!-- Оглавление на месте: отступ пункта — по уровню заголовка -->
    <Thickness x:Key="Md.Toc.Margin">0,0,0,4</Thickness>
    <Thickness x:Key="Md.Toc.Level1.Margin">0,0,0,2</Thickness>
    <Thickness x:Key="Md.Toc.Level2.Margin">16,0,0,2</Thickness>
    <Thickness x:Key="Md.Toc.Level3.Margin">32,0,0,2</Thickness>
    <Thickness x:Key="Md.Toc.Level4.Margin">48,0,0,2</Thickness>
    <Thickness x:Key="Md.Toc.Level5.Margin">64,0,0,2</Thickness>
    <Thickness x:Key="Md.Toc.Level6.Margin">80,0,0,2</Thickness>
    <DataTemplate x:Key="Md.Toc.Template" DataType="{x:Type kit:TocVm}">
        <p:MdListPresenter ItemsSource="{Binding TextMap.Headings, RelativeSource={RelativeSource AncestorType={x:Type local:MarkdownViewer}}}"
                           Margin="{DynamicResource Md.Toc.Margin}">
            <p:MdListPresenter.ItemTemplate>
                <DataTemplate DataType="{x:Type sel:MdHeading}">
                    <TextBlock x:Name="Item"
                               Margin="{DynamicResource Md.Toc.Level1.Margin}"
                               FontSize="{DynamicResource Md.Paragraph.FontSize}">
                        <Hyperlink Command="{x:Static local:MarkdownLink.ActivateCommand}"
                                   CommandParameter="{Binding Href}"
                                   Foreground="{DynamicResource Md.Paragraph.LinkForeground}"
                                   Style="{DynamicResource Md.Link.Style}">
                            <Run Text="{Binding Text, Mode=OneWay}" />
                        </Hyperlink>
                    </TextBlock>
                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding Level}" Value="2">
                            <Setter TargetName="Item" Property="Margin" Value="{DynamicResource Md.Toc.Level2.Margin}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Level}" Value="3">
                            <Setter TargetName="Item" Property="Margin" Value="{DynamicResource Md.Toc.Level3.Margin}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Level}" Value="4">
                            <Setter TargetName="Item" Property="Margin" Value="{DynamicResource Md.Toc.Level4.Margin}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Level}" Value="5">
                            <Setter TargetName="Item" Property="Margin" Value="{DynamicResource Md.Toc.Level5.Margin}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Level}" Value="6">
                            <Setter TargetName="Item" Property="Margin" Value="{DynamicResource Md.Toc.Level6.Margin}" />
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </p:MdListPresenter.ItemTemplate>
        </p:MdListPresenter>
    </DataTemplate>

    <Style TargetType="{x:Type p:MdBlockItem}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type p:MdBlockItem}">
                    <Grid>
                        <ContentPresenter />
                        <Border Background="{TemplateBinding Highlight}" IsHitTestVisible="False" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type p:MdLineGutter}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="FontFamily" Value="{DynamicResource Md.Gutter.FontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource Md.Gutter.FontSize}" />
        <Setter Property="Foreground" Value="{DynamicResource Md.Gutter.Foreground}" />
        <Setter Property="Padding" Value="{DynamicResource Md.Gutter.Padding}" />
    </Style>

    <ContextMenu x:Key="Md.ContextMenu" x:Shared="False">
        <MenuItem Header="{DynamicResource Md.ContextMenu.Copy}"
                  Command="ApplicationCommands.Copy"
                  CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}" />
        <MenuItem Header="{DynamicResource Md.ContextMenu.CopyMarkdown}"
                  Command="{x:Static local:MarkdownViewer.CopyMarkdownCommand}"
                  CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}" />
        <Separator />
        <MenuItem Header="{DynamicResource Md.ContextMenu.SelectAll}"
                  Command="ApplicationCommands.SelectAll"
                  CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}" />
    </ContextMenu>

    <Style TargetType="{x:Type local:MarkdownViewer}">
        <Setter Property="ContextMenu" Value="{DynamicResource Md.ContextMenu}" />
        <Setter Property="Focusable" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="SelectionBrush" Value="{DynamicResource Md.Selection.Brush}" />
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <p:MdBlockPanel />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
        <Setter Property="StyleProvider" Value="{DynamicResource Md.DefaultStyleProvider}" />
        <Setter Property="ItemTemplateSelector" Value="{DynamicResource Md.TemplateSelector}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:MarkdownViewer}">
                    <Border
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        Padding="{TemplateBinding Padding}"
                        SnapsToDevicePixels="True">

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <ItemsPresenter Grid.Column="1" />

                            <!-- BYDESIGN: поля идут после блоков — раскладываются позже и видят их уже на местах -->
                            <p:MdLineGutter x:Name="PART_Gutter" Visibility="Collapsed" />
                        </Grid>

                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="ShowSourceLineNumbers" Value="True">
                            <Setter TargetName="PART_Gutter" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>