    <Style x:Key="Md.Details.HeaderStyle" TargetType="{x:Type ToggleButton}" BasedOn="{StaticResource Md.Callout.HeaderStyle}" />

    <Style x:Key="Md.Details.Style" TargetType="{x:Type p:MdDetailsPresenter}">
        <Setter Property="DefaultTitle" Value="{DynamicResource Md.Details.Title}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type p:MdDetailsPresenter}">
                    <StackPanel Margin="{DynamicResource Md.Details.Margin}">
                        <ToggleButton IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                      HorizontalAlignment="Left"
                                      Style="{DynamicResource Md.Details.HeaderStyle}">
                            <StackPanel Orientation="Horizontal">
                                <Path x:Name="Marker"
                                      Data="{DynamicResource Md.Details.MarkerIcon}"
                                      Fill="{DynamicResource Md.Details.MarkerForeground}"
                                      Width="10"
                                      Height="10"
                                      Stretch="Uniform"
                                      Margin="0,0,6,0"
                                      VerticalAlignment="Center"
                                      RenderTransformOrigin="0.5,0.5">
                                    <Path.RenderTransform>
                                        <RotateTransform Angle="-90" />
                                    </Path.RenderTransform>
                                </Path>
                                <Grid VerticalAlignment="Center">
                                    <p:MdTextBlock x:Name="CustomTitle"
                                                   Visibility="Collapsed"
                                                   Runs="{TemplateBinding Summary}"
                                                   Style="{DynamicResource Md.Details.SummaryStyle}" />
                                    <TextBlock x:Name="DefaultTitle"
                                               Text="{TemplateBinding DefaultTitle}"
                                               Style="{DynamicResource Md.Details.DefaultSummaryStyle}" />
                                </Grid>
                            </StackPanel>
                        </ToggleButton>
                        <p:MdBlocksPresenter x:Name="Body"
                                             Visibility="Collapsed"
                                             Blocks="{TemplateBinding Blocks}"
                                             Margin="{DynamicResource Md.Details.ContentMargin}" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="HasSummary" Value="True">
                            <Setter TargetName="CustomTitle" Property="Visibility" Value="Visible" />
                            <Setter TargetName="DefaultTitle" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsExpanded" Value="True">
                            <Setter TargetName="Body" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Marker" Property="RenderTransform" Value="{x:Static Transform.Identity}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

