    <!-- ======== Выделение ======== -->
    <SolidColorBrush x:Key="Md.Selection.Brush" Color="#3399FF" Opacity="0.35" />

    <Style x:Key="Md.Paragraph.InlineCodeStyle" TargetType="{x:Type p:InlineCodePresenter}">
        <Setter Property="FontSize" Value="{DynamicResource Md.InlineCode.FontSize}" />
        <Setter Property="FontFamily" Value="{DynamicResource Md.InlineCode.FontFamily}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type p:InlineCodePresenter}">
                    <Border Background="{DynamicResource Md.InlineCode.Background}"
                            BorderBrush="{DynamicResource Md.InlineCode.BorderBrush}"
                            BorderThickness="{DynamicResource Md.InlineCode.BorderThickness}"
                            CornerRadius="{DynamicResource Md.InlineCode.CornerRadius}"
                            Padding="{DynamicResource Md.InlineCode.Padding}">
                        <TextBlock Text="{TemplateBinding Text}"
                                   FontSize="{TemplateBinding FontSize}"
                                   FontFamily="{TemplateBinding FontFamily}"
                                   Foreground="{DynamicResource Md.InlineCode.Foreground}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Md.Kbd.Style" TargetType="{x:Type p:InlineCodePresenter}">
        <Setter Property="FontFamily" Value="{DynamicResource Md.Kbd.FontFamily}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type p:InlineCodePresenter}">
                    <Border Background="{DynamicResource Md.Kbd.Background}"
                            BorderBrush="{DynamicResource Md.Kbd.BorderBrush}"
                            BorderThickness="{DynamicResource Md.Kbd.BorderThickness}"
                            CornerRadius="{DynamicResource Md.Kbd.CornerRadius}"
                            Padding="{DynamicResource Md.Kbd.Padding}">
                        <TextBlock Text="{TemplateBinding Text}"
                                   FontSize="{TemplateBinding FontSize}"
                                   FontFamily="{TemplateBinding FontFamily}"
                                   Foreground="{DynamicResource Md.Kbd.Foreground}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Md.Image.Style" TargetType="{x:Type p:MdImage}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type p:MdImage}">
                    <Grid>
                        <Image x:Name="Picture"
                               Source="{TemplateBinding ImageSource}"
                               Stretch="Fill"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                        <TextBlock x:Name="Alt"
                                   Visibility="Collapsed"
                                   Text="{Binding Image.Alt, RelativeSource={RelativeSource TemplatedParent}}"
                                   Foreground="{DynamicResource Md.Image.AltForeground}"
                                   FontStyle="Italic" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="ImageSource" Value="{x:Null}">
                            <Setter TargetName="Picture" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="Alt" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Md.FootnoteLink.Style" TargetType="{x:Type p:MdFootnoteLink}">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="{DynamicResource Md.Paragraph.LinkForeground}" />
        <Setter Property="FontSize" Value="{DynamicResource Md.Footnote.LinkFontSize}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type p:MdFootnoteLink}">
                    <TextBlock x:Name="Label"
