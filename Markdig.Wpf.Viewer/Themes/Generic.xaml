    <Brush x:Key="Md.Figure.CaptionForeground">Gray</Brush>
    <sys:Double x:Key="Md.Figure.CaptionFontSize">12</sys:Double>
    <Thickness x:Key="Md.Footer.Margin">0,4,0,0</Thickness>
    <Brush x:Key="Md.Footer.Foreground">Gray</Brush>
    <sys:Double x:Key="Md.Footer.FontSize">12</sys:Double>

