    <Brush x:Key="Md.CodeBlock.Foreground">Brown</Brush>
    <Brush x:Key="Md.CodeBlock.BorderBrush">#dadada</Brush>
    <Thickness x:Key="Md.CodeBlock.BorderThickness">1</Thickness>
    <Thickness x:Key="Md.CodeBlock.Padding">12</Thickness>
    <CornerRadius x:Key="Md.CodeBlock.CornerRadius">4</CornerRadius>
    <Brush x:Key="Md.CodeBlock.LineNumberForeground">Gray</Brush>
    <Thickness x:Key="Md.CodeBlock.LineNumberMargin">0,0,12,0</Thickness>
    <!-- Md.CodeBlock.HeaderFontFamily не задан: шапка берёт шрифт у приложения -->
