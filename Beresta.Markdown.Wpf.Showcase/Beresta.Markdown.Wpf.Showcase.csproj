<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0-windows</TargetFramework>
		<OutputType>WinExe</OutputType>
		<RootNamespace>Beresta.Markdown.Wpf.Showcase</RootNamespace>
		<ApplicationIcon>icon.ico</ApplicationIcon>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="HandyControls" Version="3.6.0" />
		<PackageReference Include="HandyControls.Lang.ru" Version="3.6.0" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Beresta.Markdown.Wpf\Beresta.Markdown.Wpf.csproj" />
	</ItemGroup>

	<ItemGroup>
		<None Remove="Samples\*.md;Showcases\**\*.md" />
		<EmbeddedResource Include="Samples\*.md;Showcases\**\*.md" WithCulture="false" />
		<None Update="THIRD-PARTY-NOTICES.md" CopyToOutputDirectory="PreserveNewest" />
		<Resource Include="Samples\*.png" />
		<Resource Include="icon.ico" />
	</ItemGroup>

</Project>
