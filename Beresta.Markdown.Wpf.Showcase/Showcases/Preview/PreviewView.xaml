<UserControl x:Class="Beresta.Markdown.Wpf.Showcase.Showcases.Preview.PreviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Beresta.Markdown.Wpf.Showcase.Localization"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:mdv="clr-namespace:Beresta.Markdown.Wpf;assembly=Beresta.Markdown.Wpf"
             xmlns:local="clr-namespace:Beresta.Markdown.Wpf.Showcase.Showcases.Preview"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance local:PreviewViewModel}"
             Loaded="OnLoaded"
             Unloaded="OnUnloaded">
    <DockPanel>
        <Border Style="{StaticResource ShowcaseHeader}">
            <TextBlock TextWrapping="Wrap"
                       Text="{loc:Text Preview.Header}" />
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>

            <DockPanel Margin="12">
                <!-- Номера строк редактора: по строкам исходника, а не по экранным строкам -->
                <Canvas x:Name="Numbers"
                        DockPanel.Dock="Left"
                        Width="36"
                        Margin="0,0,6,0"
                        ClipToBounds="True"
                        Visibility="{Binding Options.ShowSourceLineNumbers, Converter={StaticResource Boolean2VisibilityConverter}}"
                        IsVisibleChanged="OnNumbersVisibleChanged" />
                <TextBox x:Name="Editor"
                         Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                         AcceptsReturn="True"
                         AcceptsTab="True"
                         TextWrapping="Wrap"
                         VerticalContentAlignment="Top"
                         VerticalScrollBarVisibility="Auto"
                         FontFamily="Consolas"
                         TextChanged="OnEditorChanged"
                         SizeChanged="OnEditorChanged"
                         ScrollViewer.ScrollChanged="OnEditorChanged" />
            </DockPanel>

            <ScrollViewer Grid.Column="1">
                <mdv:MarkdownViewer x:Name="Viewer"
                                    Markdown="{Binding Text}"
                                    Margin="24,16" />
            </ScrollViewer>
        </Grid>
    </DockPanel>
</UserControl>
