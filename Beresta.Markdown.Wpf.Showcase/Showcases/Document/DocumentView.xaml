<UserControl x:Class="Beresta.Markdown.Wpf.Showcase.Showcases.Document.DocumentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Beresta.Markdown.Wpf.Showcase.Localization"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:mdv="clr-namespace:Beresta.Markdown.Wpf;assembly=Beresta.Markdown.Wpf"
             xmlns:local="clr-namespace:Beresta.Markdown.Wpf.Showcase.Showcases.Document"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance local:DocumentViewModel}">
    <UserControl.Resources>
        <local:LevelIndentConverter x:Key="LevelIndent" />
    </UserControl.Resources>

    <DockPanel>
        <Border Style="{StaticResource ShowcaseHeader}">
            <StackPanel>
                <TextBlock TextWrapping="Wrap"
                           Text="{loc:Text Document.Header}" />

                <!-- Поиск на MdSearch: поле и кнопки — у приложения, совпадения и переход — у поиска -->
                <StackPanel x:Name="SearchBar"
                            Orientation="Horizontal"
                            Margin="0,8,0,0">
                    <TextBlock Text="{loc:Text Document.Find}"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0" />
                    <TextBox x:Name="SearchBox"
                             Width="200"
                             Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}"
                             KeyDown="OnSearchKeyDown" />
                    <Button Content="▲"
                            Margin="4,0,0,0"
                            ToolTip="{loc:Text Document.Back}"
                            Click="OnPrevious" />
                    <Button Content="▼"
                            Margin="4,0,0,0"
                            ToolTip="{loc:Text Document.Next}"
                            Click="OnNext" />
                    <TextBlock x:Name="Counter"
                               VerticalAlignment="Center"
                               MinWidth="60"
                               Margin="8,0,0,0" />
                    <CheckBox Content="{loc:Text Document.MatchCase}"
                              IsChecked="{Binding MatchCase}"
                              Margin="8,0,0,0" />
                    <CheckBox Content="{loc:Text Document.WholeWord}"
                              IsChecked="{Binding WholeWord}"
                              Margin="8,0,0,0" />
                    <TextBlock VerticalAlignment="Center"
                               Margin="16,0,0,0">
                        <Run Text="{loc:Text Document.Selected}" />
                        <Run Text="{Binding SelectionLength, ElementName=Viewer, Mode=OneWay}" />
                    </TextBlock>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Оглавление: прокрутка к заголовку и текущий заголовок при прокрутке -->
        <DockPanel DockPanel.Dock="Left"
                   Width="200"
                   Margin="12,16,0,16">
            <TextBlock DockPanel.Dock="Top"
                       Text="{loc:Text Document.Headings}"
                       FontWeight="SemiBold"
                       Margin="0,0,0,4" />
            <ListBox x:Name="Contents"
                     ItemsSource="{Binding TextMap.Headings, ElementName=Viewer}"
                     SelectionChanged="OnContentsSelectionChanged">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Text}"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="{Binding Level, Converter={StaticResource LevelIndent}}" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <ScrollViewer>
            <mdv:MarkdownViewer x:Name="Viewer"
                                Markdown="{Binding Text}"
                                ViewportChanged="OnViewportChanged"
                                Margin="24,16" />
        </ScrollViewer>
    </DockPanel>
</UserControl>