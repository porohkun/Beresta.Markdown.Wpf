<UserControl x:Class="Beresta.Markdown.Wpf.Showcase.Showcases.Sets.SetsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Beresta.Markdown.Wpf.Showcase.Localization"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:mdv="clr-namespace:Beresta.Markdown.Wpf;assembly=Beresta.Markdown.Wpf"
             xmlns:local="clr-namespace:Beresta.Markdown.Wpf.Showcase.Showcases.Sets"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance local:SetsViewModel}"
             Loaded="OnLoaded"
             Unloaded="OnUnloaded">
    <DockPanel>
        <Border Style="{StaticResource ShowcaseHeader}">
            <StackPanel>
                <TextBlock TextWrapping="Wrap"
                           Text="{loc:Text Sets.Header}" />

                <!-- Выбор диалекта и сравнение с документом без набора -->
                <DockPanel Margin="0,8,0,0">
                    <ComboBox DockPanel.Dock="Left"
                              Width="240"
                              Style="{StaticResource ComboBoxExtend}"
                              hc:InfoElement.TitlePlacement="Top"
                              hc:InfoElement.Title="{loc:Text Sets.Set}"
                              ItemsSource="{Binding Dialects}"
                              SelectedItem="{Binding Selected}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{loc:TextOf TitleKey}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <CheckBox DockPanel.Dock="Left"
                              Margin="16,0,0,4"
                              VerticalAlignment="Bottom"
                              Content="{loc:Text Sets.SetOn}"
                              IsChecked="{Binding IsSetOn}" />
                    <TextBlock Margin="16,0,0,6"
                               VerticalAlignment="Bottom"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               Text="{Binding LastLink}" />
                </DockPanel>
            </StackPanel>
        </Border>

        <ScrollViewer>
            <mdv:MarkdownViewer x:Name="Viewer"
                                Markdown="{Binding Selected.Text}"
                                Margin="24,16"
                                mdv:MarkdownLink.Navigate="OnLink" />
        </ScrollViewer>
    </DockPanel>
</UserControl>
