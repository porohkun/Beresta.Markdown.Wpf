<UserControl x:Class="Beresta.Markdown.Wpf.Showcase.Showcases.CustomLook.CustomLookView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Beresta.Markdown.Wpf.Showcase.Localization"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:mdv="clr-namespace:Beresta.Markdown.Wpf;assembly=Beresta.Markdown.Wpf"
             xmlns:p="clr-namespace:Beresta.Markdown.Wpf.Presenters;assembly=Beresta.Markdown.Wpf"
             xmlns:s="clr-namespace:Beresta.Markdown.Wpf.Styling;assembly=Beresta.Markdown.Wpf"
             xmlns:vm="clr-namespace:Beresta.Markdown.Wpf.ViewModels;assembly=Beresta.Markdown.Wpf"
             xmlns:local="clr-namespace:Beresta.Markdown.Wpf.Showcase.Showcases.CustomLook"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance local:CustomLookViewModel}">
    <UserControl.Resources>
        <!-- Заголовок с полосой слева, остальные шаблоны стандартные -->
        <s:MdStyleProvider x:Key="AccentProvider"
                           BasedOn="{StaticResource Md.DefaultStyleProvider}">
            <s:MdStyleProvider.HeadingTemplate>
                <DataTemplate DataType="{x:Type vm:HeadingVm}">
                    <Border Margin="0,12,0,4"
                            Padding="10,0,0,0"
                            BorderThickness="4,0,0,0"
                            BorderBrush="{DynamicResource PrimaryBrush}">
                        <p:MdHeadingBlock Level="{Binding Level}"
                                          Runs="{Binding Inlines}"
                                          Style="{DynamicResource Md.Heading.Style}"
                                          Margin="0" />
                    </Border>
                </DataTemplate>
            </s:MdStyleProvider.HeadingTemplate>
        </s:MdStyleProvider>
    </UserControl.Resources>

    <DockPanel>
        <Border Style="{StaticResource ShowcaseHeader}">
            <StackPanel>
                <TextBlock TextWrapping="Wrap"
                           Text="{loc:Text CustomLook.Header}" />

                <!-- Что витрина меняет сама: своё или стандартное -->
                <WrapPanel Margin="0,8,0,0">
                    <TextBlock Text="{loc:Text CustomLook.Font}"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0" />
                    <hc:ButtonGroup Margin="0,0,24,0">
                        <RadioButton Content="{loc:Text CustomLook.Standard}" IsChecked="{Binding IsCustomFont, Converter={StaticResource Boolean2BooleanReConverter}}" />
                        <RadioButton Content="{loc:Text CustomLook.Custom}" IsChecked="{Binding IsCustomFont}" />
                    </hc:ButtonGroup>
                    <TextBlock Text="{loc:Text CustomLook.Headings}"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0" />
                    <hc:ButtonGroup>
                        <RadioButton Content="{loc:Text CustomLook.Standard}" IsChecked="{Binding IsCustomHeadings, Converter={StaticResource Boolean2BooleanReConverter}}" />
                        <RadioButton Content="{loc:Text CustomLook.Custom}" IsChecked="{Binding IsCustomHeadings}" />
                    </hc:ButtonGroup>
                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- Ключи темы: своё значение ложится в ресурсы вьюера -->
        <DockPanel DockPanel.Dock="Right"
                   Width="440"
                   Margin="0,12,12,12">
            <DockPanel DockPanel.Dock="Top"
                       Margin="0,0,0,4">
                <Button DockPanel.Dock="Right"
                        Content="{loc:Text CustomLook.Reset}"
                        Click="OnReset" />
                <TextBlock Text="{loc:Text CustomLook.Keys}"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center" />
            </DockPanel>
            <local:ThemeKeyGrid SelectedObject="{Binding Keys}"
                                MinTitleWidth="240"
                                MaxTitleWidth="240" />
        </DockPanel>

        <ScrollViewer>
            <mdv:MarkdownViewer x:Name="Viewer"
                                Markdown="{Binding Text}"
                                Margin="24,16" />
        </ScrollViewer>
    </DockPanel>
</UserControl>
