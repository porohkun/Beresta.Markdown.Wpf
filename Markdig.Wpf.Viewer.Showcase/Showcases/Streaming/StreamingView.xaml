<UserControl x:Class="MarkdigWpfViewer.Showcase.Showcases.Streaming.StreamingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:MarkdigWpfViewer.Showcase.Localization"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:mdv="clr-namespace:MarkdigWpfViewer;assembly=Markdig.Wpf.Viewer"
             xmlns:b="clr-namespace:MarkdigWpfViewer.Behaviors;assembly=Markdig.Wpf.Viewer"
             xmlns:local="clr-namespace:MarkdigWpfViewer.Showcase.Showcases.Streaming"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance local:StreamingViewModel}">
    <DockPanel>
        <Border Style="{StaticResource ShowcaseHeader}">
            <StackPanel>
                <TextBlock TextWrapping="Wrap"
                           Text="{loc:Text Streaming.Header}" />

                <WrapPanel Margin="0,8,0,0">
                    <Button Content="{loc:Text Streaming.Start}" Click="OnStart" Margin="0,0,8,4" />
                    <Button Content="{loc:Text Streaming.Stop}" Click="OnStop" Margin="0,0,16,4" />
                    <ComboBox SelectedIndex="{Binding Speed}" Width="130" Margin="0,0,8,4">
                        <ComboBoxItem Content="{loc:Text Streaming.Speed.Model}" />
                        <ComboBoxItem Content="{loc:Text Streaming.Speed.Fast}" />
                        <ComboBoxItem Content="{loc:Text Streaming.Speed.AllAtOnce}" />
                    </ComboBox>
                    <ComboBox SelectedIndex="{Binding IntervalChoice}" Width="150" Margin="0,0,8,4">
                        <ComboBoxItem Content="{loc:Text Streaming.Interval.50}" />
                        <ComboBoxItem Content="{loc:Text Streaming.Interval.100}" />
                        <ComboBoxItem Content="{loc:Text Streaming.Interval.200}" />
                        <ComboBoxItem Content="{loc:Text Streaming.Interval.None}" />
                    </ComboBox>
                    <ComboBox SelectedValue="{Binding Edge}" SelectedValuePath="Tag" Width="170" Margin="0,0,8,4">
                        <ComboBoxItem Content="{loc:Text Streaming.Stick.Bottom}" Tag="{x:Static b:StickyEdge.Bottom}" />
                        <ComboBoxItem Content="{loc:Text Streaming.Stick.Top}" Tag="{x:Static b:StickyEdge.Top}" />
                        <ComboBoxItem Content="{loc:Text Streaming.Stick.None}" Tag="{x:Static b:StickyEdge.None}" />
                    </ComboBox>
                    <CheckBox Content="{loc:Text Streaming.Unstick}"
                              IsChecked="{Binding CanUnstick}"
                              VerticalAlignment="Center"
                              Margin="0,0,0,4" />
                </WrapPanel>

                <!-- Сколько кусков пришло и сколько раз вьюер получил текст -->
                <TextBlock x:Name="Status"
                           Margin="0,2,0,0"
                           Foreground="{DynamicResource SecondaryTextBrush}" />
            </StackPanel>
        </Border>

        <ScrollViewer x:Name="Scroll"
                      b:StickyScroll.Edge="{Binding Edge}"
                      b:StickyScroll.CanUnstick="{Binding CanUnstick}">
            <mdv:MarkdownViewer x:Name="Viewer" Margin="24,16" ImagePolicy="{x:Static mdv:MdImagePolicy.Untrusted}" />
        </ScrollViewer>
    </DockPanel>
</UserControl>
