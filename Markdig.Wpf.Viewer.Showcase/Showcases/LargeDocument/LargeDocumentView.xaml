<UserControl x:Class="MarkdigWpfViewer.Showcase.Showcases.LargeDocument.LargeDocumentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:mdv="clr-namespace:MarkdigWpfViewer;assembly=Markdig.Wpf.Viewer"
             xmlns:local="clr-namespace:MarkdigWpfViewer.Showcase.Showcases.LargeDocument"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance local:LargeDocumentViewModel}">
    <DockPanel>
        <Border Style="{StaticResource ShowcaseHeader}">
            <TextBlock TextWrapping="Wrap"
                       Text="Три тысячи блоков в одном вьюере: контролы создаются только для видимых, остальные — по мере прокрутки." />
        </Border>

        <ScrollViewer>
            <mdv:MarkdownViewer Markdown="{Binding Text}"
                                Margin="24,16" />
        </ScrollViewer>
    </DockPanel>
</UserControl>