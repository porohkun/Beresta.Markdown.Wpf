<UserControl x:Class="MarkdigWpfViewer.Showcase.Showcases.Preview.PreviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:mdv="clr-namespace:MarkdigWpfViewer;assembly=Markdig.Wpf.Viewer"
             xmlns:local="clr-namespace:MarkdigWpfViewer.Showcase.Showcases.Preview"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance local:PreviewViewModel}"
             Loaded="OnLoaded"
             Unloaded="OnUnloaded">
    <DockPanel>
        <Border Style="{StaticResource ShowcaseHeader}">
            <TextBlock TextWrapping="Wrap"
                       Text="Редактор и предпросмотр рядом: каждая правка доходит до вьюера изменениями — неизменившиеся блоки остаются как были, а видимое не прыгает. Прокрутка общая — MdScrollSync между вьюером и редактором через MdTextBoxLines; по нему же стоят номера строк редактора." />
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>

            <DockPanel Margin="12">
                <!-- Номера строк редактора: по строкам исходника, а не по экранным строкам -->
                <Canvas x:Name="Numbers"
                        DockPanel.Dock="Left"
                        Width="36"
                        Margin="0,0,6,0"
                        ClipToBounds="True"
                        Visibility="{Binding Options.ShowSourceLineNumbers, Converter={StaticResource Boolean2VisibilityConverter}}"
                        IsVisibleChanged="OnNumbersVisibleChanged" />
                <TextBox x:Name="Editor"
                         Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                         AcceptsReturn="True"
                         AcceptsTab="True"
                         TextWrapping="Wrap"
                         VerticalContentAlignment="Top"
                         VerticalScrollBarVisibility="Auto"
                         FontFamily="Consolas"
                         TextChanged="OnEditorChanged"
                         SizeChanged="OnEditorChanged"
                         ScrollViewer.ScrollChanged="OnEditorChanged" />
            </DockPanel>

            <ScrollViewer Grid.Column="1">
                <mdv:MarkdownViewer x:Name="Viewer"
                                    Markdown="{Binding Text}"
                                    Margin="24,16" />
            </ScrollViewer>
        </Grid>
    </DockPanel>
</UserControl>
