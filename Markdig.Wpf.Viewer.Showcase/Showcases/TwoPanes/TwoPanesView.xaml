<UserControl x:Class="MarkdigWpfViewer.Showcase.Showcases.TwoPanes.TwoPanesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:mdv="clr-namespace:MarkdigWpfViewer;assembly=Markdig.Wpf.Viewer"
             xmlns:local="clr-namespace:MarkdigWpfViewer.Showcase.Showcases.TwoPanes"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance local:TwoPanesViewModel}"
             Loaded="OnLoaded"
             Unloaded="OnUnloaded">
    <DockPanel>
        <Border Style="{StaticResource ShowcaseHeader}">
            <StackPanel>
                <TextBlock TextWrapping="Wrap"
                           Text="Две версии статьи, как в диффе. Синхронную прокрутку ведёт MdScrollSync, а каждую правку одной фигурой — подсветку строк в обеих панелях, соединение и общий контур — витрина рисует по координатам вьюеров. Внутри строк дописанное и удалённое подсвечено, а на его месте с другой стороны — вертикальная черта; заменённое — в рамках. Вровень панели ставит MdPaneAligner — напротив правок пустые места." />
                <hc:ButtonGroup HorizontalAlignment="Left"
                                Margin="0,8,0,0">
                    <RadioButton Content="Синхронная прокрутка" IsChecked="True" />
                    <RadioButton Content="Вровень" IsChecked="{Binding IsAligned}" />
                </hc:ButtonGroup>
            </StackPanel>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="48" />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition />
            </Grid.RowDefinitions>

            <TextBlock Text="Было" Margin="24,8,24,0" FontWeight="SemiBold" />
            <TextBlock Grid.Column="2" Text="Стало" Margin="24,8,24,0" FontWeight="SemiBold" />

            <!-- Синхронная прокрутка: у панелей свои прокрутки, поверх них — правки одной фигурой -->
            <Grid Grid.Row="1" Grid.ColumnSpan="3">
                <Grid.Style>
                    <Style TargetType="{x:Type Grid}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsAligned}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition x:Name="Gap" Width="48" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>

                <ScrollViewer>
                    <mdv:MarkdownViewer x:Name="SyncLeft" Markdown="{Binding Left}" Margin="24,16" />
                </ScrollViewer>
                <ScrollViewer Grid.Column="2">
                    <mdv:MarkdownViewer x:Name="SyncRight" Markdown="{Binding Right}" Margin="24,16" />
                </ScrollViewer>
                <Canvas x:Name="Connections"
                        Grid.ColumnSpan="3"
                        ClipToBounds="True"
                        IsHitTestVisible="False"
                        SizeChanged="OnConnectionsSizeChanged" />
            </Grid>

            <!-- Вровень: общая прокрутка, напротив правок — пустые места -->
            <ScrollViewer Grid.Row="1" Grid.ColumnSpan="3">
                <ScrollViewer.Style>
                    <Style TargetType="{x:Type ScrollViewer}" BasedOn="{StaticResource {x:Type ScrollViewer}}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsAligned}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ScrollViewer.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="48" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>

                    <mdv:MarkdownViewer x:Name="AlignedLeft" Markdown="{Binding Left}" Margin="24,16" />
                    <mdv:MarkdownViewer x:Name="AlignedRight" Grid.Column="2" Markdown="{Binding Right}" Margin="24,16" />
                </Grid>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</UserControl>
