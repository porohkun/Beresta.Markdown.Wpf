<UserControl x:Class="MarkdigWpfViewer.Showcase.Showcases.Document.DocumentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:mdv="clr-namespace:MarkdigWpfViewer;assembly=Markdig.Wpf.Viewer"
             xmlns:local="clr-namespace:MarkdigWpfViewer.Showcase.Showcases.Document"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance local:DocumentViewModel}">
    <UserControl.Resources>
        <local:LevelIndentConverter x:Key="LevelIndent" />
    </UserControl.Resources>

    <DockPanel>
        <!-- Подсветка найденного и выделение -->
        <StackPanel DockPanel.Dock="Top"
                    Orientation="Horizontal"
                    Margin="24,8,24,0">
            <TextBlock Text="Подсветить:"
                       VerticalAlignment="Center"
                       Margin="0,0,8,0" />
            <TextBox x:Name="SearchBox"
                     Width="200"
                     TextChanged="OnSearchChanged" />
            <TextBlock VerticalAlignment="Center"
                       Margin="16,0,0,0"
                       Text="{Binding SelectionLength, ElementName=Viewer, StringFormat='Выделено знаков: {0}'}" />
        </StackPanel>

        <!-- Оглавление: прокрутка к заголовку и текущий заголовок при прокрутке -->
        <ListBox x:Name="Contents"
                 DockPanel.Dock="Left"
                 Width="200"
                 Margin="12,16,0,16"
                 ItemsSource="{Binding TextMap.Headings, ElementName=Viewer}"
                 SelectionChanged="OnContentsSelectionChanged">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Text}"
                               TextTrimming="CharacterEllipsis"
                               Margin="{Binding Level, Converter={StaticResource LevelIndent}}" />
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <ScrollViewer>
            <mdv:MarkdownViewer x:Name="Viewer"
                                Markdown="{Binding Text}"
                                CanToggleTasks="True"
                                TaskToggled="OnTaskToggled"
                                ViewportChanged="OnViewportChanged"
                                Margin="24,16" />
        </ScrollViewer>
    </DockPanel>
</UserControl>
