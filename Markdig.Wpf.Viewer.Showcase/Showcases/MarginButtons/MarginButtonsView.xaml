<UserControl x:Class="MarkdigWpfViewer.Showcase.Showcases.MarginButtons.MarginButtonsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:mdv="clr-namespace:MarkdigWpfViewer;assembly=Markdig.Wpf.Viewer"
             xmlns:local="clr-namespace:MarkdigWpfViewer.Showcase.Showcases.MarginButtons"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance local:MarginButtonsViewModel}">
    <UserControl.Resources>
        <Style x:Key="LineButton" TargetType="{x:Type ToggleButton}">
            <Setter Property="Width" Value="12" />
            <Setter Property="Height" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                        <Ellipse x:Name="Dot"
                                 Fill="Transparent"
                                 Stroke="{DynamicResource BorderBrush}"
                                 StrokeThickness="1" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Dot" Property="Stroke" Value="{DynamicResource PrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource PrimaryBrush}" />
                                <Setter TargetName="Dot" Property="Stroke" Value="{DynamicResource PrimaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <DockPanel>
        <Border Style="{StaticResource ShowcaseHeader}">
            <TextBlock TextWrapping="Wrap"
                       Text="Колонка приложения рядом с вьюером, в одной с ним прокрутке: кружки — обычные кнопки WPF у видимых строк, места для них даёт GetCoordinates. Щелчок по кружку делает строку закладкой — пометкой своего слоя." />
        </Border>

        <ScrollViewer>
            <Grid Margin="0,16,24,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="28" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>

                <Canvas x:Name="Marks" />
                <mdv:MarkdownViewer x:Name="Viewer"
                                    Grid.Column="1"
                                    Markdown="{Binding Markdown}"
                                    ViewportChanged="OnViewportChanged" />
            </Grid>
        </ScrollViewer>
    </DockPanel>
</UserControl>
