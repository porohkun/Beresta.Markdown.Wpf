<UserControl x:Class="MarkdigWpfViewer.Showcase.Showcases.Sets.SetsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:mdv="clr-namespace:MarkdigWpfViewer;assembly=Markdig.Wpf.Viewer"
             xmlns:local="clr-namespace:MarkdigWpfViewer.Showcase.Showcases.Sets"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance local:SetsViewModel}"
             Loaded="OnLoaded"
             Unloaded="OnUnloaded">
    <DockPanel>
        <Border Style="{StaticResource ShowcaseHeader}">
            <StackPanel>
                <TextBlock TextWrapping="Wrap"
                           Text="Набор — готовые расширения под синтаксис одной программы, подключённые одной строкой. Без флажка тот же документ показан без набора." />

                <!-- Выбор диалекта и сравнение с документом без набора -->
                <DockPanel Margin="0,8,0,0">
                    <ComboBox DockPanel.Dock="Left"
                              Width="240"
                              Style="{StaticResource ComboBoxExtend}"
                              hc:InfoElement.TitlePlacement="Top"
                              hc:InfoElement.Title="Набор"
                              ItemsSource="{Binding Dialects}"
                              SelectedItem="{Binding Selected}"
                              DisplayMemberPath="Title" />
                    <CheckBox DockPanel.Dock="Left"
                              Margin="16,0,0,4"
                              VerticalAlignment="Bottom"
                              Content="Набор подключён"
                              IsChecked="{Binding IsSetOn}" />
                    <TextBlock Margin="16,0,0,6"
                               VerticalAlignment="Bottom"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               Text="{Binding LastLink}" />
                </DockPanel>
            </StackPanel>
        </Border>

        <ScrollViewer>
            <mdv:MarkdownViewer x:Name="Viewer"
                                Markdown="{Binding Selected.Text}"
                                Margin="24,16"
                                mdv:MarkdownLink.Navigate="OnLink" />
        </ScrollViewer>
    </DockPanel>
</UserControl>
