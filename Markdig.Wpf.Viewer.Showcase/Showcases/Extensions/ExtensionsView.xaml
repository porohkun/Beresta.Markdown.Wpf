<UserControl x:Class="MarkdigWpfViewer.Showcase.Showcases.Extensions.ExtensionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:mdv="clr-namespace:MarkdigWpfViewer;assembly=Markdig.Wpf.Viewer"
             xmlns:mdx="clr-namespace:MarkdigWpfViewer.Extensions;assembly=Markdig.Wpf.Viewer"
             xmlns:p="clr-namespace:MarkdigWpfViewer.Presenters;assembly=Markdig.Wpf.Viewer"
             xmlns:local="clr-namespace:MarkdigWpfViewer.Showcase.Showcases.Extensions"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance local:ExtensionsViewModel}">
    <UserControl.Resources>
        <!-- Свёрнута ли заметка — в её состоянии: переживает прокрутку и правку текста -->
        <DataTemplate x:Key="NoteTemplate" DataType="{x:Type local:NoteVm}">
            <Border Margin="0,4,0,8"
                    Padding="12,8"
                    CornerRadius="4"
                    BorderThickness="4,0,0,0"
                    BorderBrush="{DynamicResource PrimaryBrush}"
                    Background="{DynamicResource SecondaryRegionBrush}">
                <StackPanel>
                    <ToggleButton x:Name="Toggle"
                                  HorizontalAlignment="Left"
                                  Margin="0,0,0,4"
                                  Cursor="Hand"
                                  IsChecked="{Binding (mdx:MdWidget.State).IsExpanded, RelativeSource={RelativeSource Self}}">
                        <ToggleButton.Template>
                            <ControlTemplate TargetType="{x:Type ToggleButton}">
                                <ContentPresenter />
                            </ControlTemplate>
                        </ToggleButton.Template>
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <TextBlock x:Name="Arrow"
                                       Text="▾"
                                       Margin="0,0,6,0"
                                       Foreground="{DynamicResource PrimaryBrush}" />
                            <TextBlock Text="{Binding Title}"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource PrimaryBrush}" />
                        </StackPanel>
                    </ToggleButton>
                    <p:MdBlocksPresenter x:Name="Content" Blocks="{Binding Blocks}" />
                </StackPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsChecked, ElementName=Toggle}" Value="False">
                    <Setter TargetName="Content" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="Arrow" Property="Text" Value="▸" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Упоминание — кнопка: щелчок идёт по ссылке тем же путём, что ссылка в тексте -->
        <DataTemplate x:Key="MentionTemplate" DataType="{x:Type local:MentionVm}">
            <Button Command="{x:Static mdv:MarkdownLink.ActivateCommand}"
                    CommandParameter="{Binding Url}"
                    ToolTip="{Binding Url}"
                    Height="Auto"
                    MinHeight="0"
                    Cursor="Hand">
                <Button.Template>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border Padding="6,0"
                                CornerRadius="8"
                                Background="{DynamicResource PrimaryBrush}">
                            <TextBlock Text="{Binding Name, StringFormat='@{0}'}"
                                       Foreground="White" />
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </DataTemplate>

        <!-- Оформление «Chip» для чипов ::текст:: -->
        <SolidColorBrush x:Key="ChipBrush" Color="{DynamicResource PrimaryColor}" Opacity="0.16" />
        <Style x:Key="Md.Chip.Style" TargetType="{x:Type Span}">
            <Setter Property="Background" Value="{DynamicResource ChipBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
        </Style>
    </UserControl.Resources>

    <DockPanel>
        <Border Style="{StaticResource ShowcaseHeader}">
            <TextBlock TextWrapping="Wrap"
                       Text="Свой синтаксис на MdExtension: заметка :::note со своим состоянием, упоминание @имя со своим разбором и чипы ::текст:: — оформленный текст, а не виджет. Каждое расширение подключено отдельно, строкой в Extensions вьюера; наборы — на витрине «Наборы»." />
        </Border>

        <ScrollViewer>
            <mdv:MarkdownViewer Markdown="{Binding Text}"
                                Margin="24,16">
                <mdv:MarkdownViewer.Extensions>
                    <local:NoteExtension Template="{StaticResource NoteTemplate}" />
                    <local:MentionExtension Template="{StaticResource MentionTemplate}" />
                    <local:ChipExtension />
                </mdv:MarkdownViewer.Extensions>
            </mdv:MarkdownViewer>
        </ScrollViewer>
    </DockPanel>
</UserControl>