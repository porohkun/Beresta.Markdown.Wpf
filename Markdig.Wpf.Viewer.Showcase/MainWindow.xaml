<hc:Window x:Class="MarkdigWpfViewer.Showcase.MainWindow"
           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
           xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
           xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
           xmlns:hc="https://handyorg.github.io/handycontrol"
           xmlns:mdv="clr-namespace:MarkdigWpfViewer;assembly=Markdig.Wpf.Viewer"
           xmlns:p="clr-namespace:MarkdigWpfViewer.Presenters;assembly=Markdig.Wpf.Viewer"
           xmlns:s="clr-namespace:MarkdigWpfViewer.Styling;assembly=Markdig.Wpf.Viewer"
           xmlns:vm="clr-namespace:MarkdigWpfViewer.ViewModels;assembly=Markdig.Wpf.Viewer"
           xmlns:ext="clr-namespace:MarkdigWpfViewer.Showcase.Extensions"
           xmlns:local="clr-namespace:MarkdigWpfViewer.Showcase"
           mc:Ignorable="d"
           d:DataContext="{d:DesignInstance local:MainWindowViewModel, IsDesignTimeCreatable=True}"
           Title="Markdig.Wpf.Viewer — витрина"
           Width="1000"
           Height="800"
           Background="{DynamicResource RegionBrush}">
    <hc:Window.DataContext>
        <local:MainWindowViewModel />
    </hc:Window.DataContext>

    <hc:Window.Resources>
        <!-- Шаблоны виджетов -->
        <DataTemplate x:Key="Showcase.NoteTemplate" DataType="{x:Type ext:NoteVm}">
            <Border Margin="0,4,0,8"
                    Padding="12,8"
                    CornerRadius="4"
                    BorderThickness="4,0,0,0"
                    BorderBrush="{DynamicResource PrimaryBrush}"
                    Background="{DynamicResource SecondaryRegionBrush}">
                <StackPanel>
                    <TextBlock Text="{Binding Title}"
                               Margin="0,0,0,4"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource PrimaryBrush}" />
                    <p:MdBlocksPresenter Blocks="{Binding Blocks}" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="Showcase.MentionTemplate" DataType="{x:Type ext:MentionVm}">
            <Border Padding="6,0"
                    CornerRadius="8"
                    Background="{DynamicResource PrimaryBrush}">
                <TextBlock Text="{Binding Name, StringFormat='@{0}'}"
                           Foreground="White" />
            </Border>
        </DataTemplate>

        <!-- Свой вид: заголовок с полосой слева, остальные шаблоны стандартные -->
        <s:MdStyleProvider x:Key="Showcase.AccentProvider"
                           BasedOn="{StaticResource Md.DefaultStyleProvider}">
            <s:MdStyleProvider.HeadingTemplate>
                <DataTemplate DataType="{x:Type vm:HeadingVm}">
                    <Border Margin="0,12,0,4"
                            Padding="10,0,0,0"
                            BorderThickness="4,0,0,0"
                            BorderBrush="{DynamicResource PrimaryBrush}">
                        <p:MdHeadingBlock Level="{Binding Level}"
                                          Runs="{Binding Inlines}"
                                          Style="{DynamicResource Md.Heading.Style}"
                                          Margin="0" />
                    </Border>
                </DataTemplate>
            </s:MdStyleProvider.HeadingTemplate>
        </s:MdStyleProvider>
    </hc:Window.Resources>

    <DockPanel>
        <!-- Панель настроек -->
        <StackPanel DockPanel.Dock="Top"
                    Orientation="Horizontal"
                    Margin="12,8">
            <CheckBox Content="Тёмная тема"
                      IsChecked="{Binding IsDark}" />
        </StackPanel>

        <TabControl x:Name="Scenarios">
            <TabItem Header="Документ">
                <DockPanel>
                    <!-- Подсветка найденного и выделение -->
                    <StackPanel DockPanel.Dock="Top"
                                Orientation="Horizontal"
                                Margin="24,8,24,0">
                        <TextBlock Text="Подсветить:"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0" />
                        <TextBox x:Name="SearchBox"
                                 Width="200"
                                 TextChanged="OnSearchChanged" />
                        <TextBlock VerticalAlignment="Center"
                                   Margin="16,0,0,0"
                                   Text="{Binding SelectionLength, ElementName=DocumentViewer, StringFormat='Выделено знаков: {0}'}" />
                    </StackPanel>

                    <ScrollViewer>
                        <mdv:MarkdownViewer x:Name="DocumentViewer"
                                            Markdown="{Binding Document}"
                                            Margin="24,16" />
                    </ScrollViewer>
                </DockPanel>
            </TabItem>

            <TabItem Header="Расширения">
                <ScrollViewer>
                    <mdv:MarkdownViewer Markdown="{Binding ExtensionsDocument}"
                                        Margin="24,16">
                        <mdv:MarkdownViewer.Extensions>
                            <ext:NoteExtension Template="{StaticResource Showcase.NoteTemplate}" />
                            <ext:MentionExtension Template="{StaticResource Showcase.MentionTemplate}" />
                        </mdv:MarkdownViewer.Extensions>
                    </mdv:MarkdownViewer>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Свой вид">
                <ScrollViewer>
                    <mdv:MarkdownViewer Markdown="{Binding Document}"
                                        Margin="24,16"
                                        FontFamily="Georgia"
                                        StyleProvider="{StaticResource Showcase.AccentProvider}">
                        <mdv:MarkdownViewer.Resources>
                            <Style x:Key="Md.Strong.Style" TargetType="{x:Type Span}">
                                <Setter Property="FontWeight" Value="Bold" />
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
                            </Style>
                        </mdv:MarkdownViewer.Resources>
                    </mdv:MarkdownViewer>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Большой документ">
                <ScrollViewer>
                    <mdv:MarkdownViewer Markdown="{Binding LargeDocument}"
                                        Margin="24,16" />
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </DockPanel>
</hc:Window>
