<hc:Window x:Class="MarkdigWpfViewer.Showcase.MainWindow"
           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
           xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
           xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
           xmlns:hc="https://handyorg.github.io/handycontrol"
           xmlns:mdv="clr-namespace:MarkdigWpfViewer;assembly=Markdig.Wpf.Viewer"
           xmlns:local="clr-namespace:MarkdigWpfViewer.Showcase"
           xmlns:loc="clr-namespace:MarkdigWpfViewer.Showcase.Localization"
           xmlns:document="clr-namespace:MarkdigWpfViewer.Showcase.Showcases.Document"
           xmlns:extensions="clr-namespace:MarkdigWpfViewer.Showcase.Showcases.Extensions"
           xmlns:kit="clr-namespace:MarkdigWpfViewer.Showcase.Showcases.Kit"
           xmlns:sets="clr-namespace:MarkdigWpfViewer.Showcase.Showcases.Sets"
           xmlns:look="clr-namespace:MarkdigWpfViewer.Showcase.Showcases.CustomLook"
           xmlns:panes="clr-namespace:MarkdigWpfViewer.Showcase.Showcases.TwoPanes"
           xmlns:large="clr-namespace:MarkdigWpfViewer.Showcase.Showcases.LargeDocument"
           xmlns:chat="clr-namespace:MarkdigWpfViewer.Showcase.Showcases.Chat"
           xmlns:streaming="clr-namespace:MarkdigWpfViewer.Showcase.Showcases.Streaming"
           xmlns:margin="clr-namespace:MarkdigWpfViewer.Showcase.Showcases.MarginButtons"
           xmlns:preview="clr-namespace:MarkdigWpfViewer.Showcase.Showcases.Preview"
           xmlns:copying="clr-namespace:MarkdigWpfViewer.Showcase.Showcases.Copying"
           xmlns:about="clr-namespace:MarkdigWpfViewer.Showcase.Showcases.About"
           mc:Ignorable="d"
           d:DataContext="{d:DesignInstance local:MainWindowViewModel, IsDesignTimeCreatable=True}"
           Title="{loc:Text Window.Title}"
           Width="1100"
           Height="800"
           WindowStartupLocation="CenterScreen"
           Background="{DynamicResource RegionBrush}">
    <hc:Window.DataContext>
        <local:MainWindowViewModel />
    </hc:Window.DataContext>

    <hc:Window.Resources>
        <!-- Общие настройки доходят до всех вьюеров витрин -->
        <Style TargetType="{x:Type mdv:MarkdownViewer}" BasedOn="{StaticResource {x:Type mdv:MarkdownViewer}}">
            <Setter Property="ShowSourceLineNumbers" Value="{Binding Options.ShowSourceLineNumbers}" />
            <Setter Property="IsSelectionEnabled" Value="{Binding Options.IsSelectionEnabled}" />
            <Setter Property="BaseUri" Value="pack://application:,,,/Markdig.Wpf.Viewer.Showcase;component/Samples/" />
        </Style>

        <!-- Капсулы HandyControl, полоса заголовков слева и прижата к верху -->
        <Style x:Key="ShowcaseTabs" TargetType="{x:Type TabControl}" BasedOn="{StaticResource TabControlCapsule}">
            <Setter Property="TabStripPlacement" Value="Left" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TabControl}">
                        <Grid Background="{TemplateBinding Background}"
                              ClipToBounds="True"
                              SnapsToDevicePixels="True">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <UniformGrid Columns="1"
                                         IsItemsHost="True"
                                         VerticalAlignment="Top"
                                         Margin="0,1,0,0"
                                         Background="Transparent"
                                         KeyboardNavigation.TabNavigation="Once"
                                         KeyboardNavigation.DirectionalNavigation="Cycle" />

                            <Border Grid.Column="1"
                                    Margin="6,0,0,0"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    Background="{TemplateBinding Background}">
                                <ContentPresenter x:Name="PART_SelectedContentHost"
                                                  ContentSource="SelectedContent"
                                                  SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Вид витрины — по типу её вьюмодели -->
        <DataTemplate DataType="{x:Type document:DocumentViewModel}">
            <document:DocumentView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type extensions:ExtensionsViewModel}">
            <extensions:ExtensionsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type kit:KitViewModel}">
            <kit:KitView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type sets:SetsViewModel}">
            <sets:SetsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type look:CustomLookViewModel}">
            <look:CustomLookView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type panes:TwoPanesViewModel}">
            <panes:TwoPanesView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type margin:MarginButtonsViewModel}">
            <margin:MarginButtonsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type large:LargeDocumentViewModel}">
            <large:LargeDocumentView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type chat:ChatViewModel}">
            <chat:ChatView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type streaming:StreamingViewModel}">
            <streaming:StreamingView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type preview:PreviewViewModel}">
            <preview:PreviewView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type copying:CopyingViewModel}">
            <copying:CopyingView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type about:AboutViewModel}">
            <about:AboutView />
        </DataTemplate>

        <Geometry x:Key="LightIcon">M565-395q35-35 35-85t-35-85q-35-35-85-35t-85 35q-35 35-35 85t35 85q35 35 85 35t85-35Zm-226.5 56.5Q280-397 280-480t58.5-141.5Q397-680 480-680t141.5 58.5Q680-563 680-480t-58.5 141.5Q563-280 480-280t-141.5-58.5ZM200-440H40v-80h160v80Zm720 0H760v-80h160v80ZM440-760v-160h80v160h-80Zm0 720v-160h80v160h-80ZM256-650l-101-97 57-59 96 100-52 56Zm492 496-97-101 53-55 101 97-57 59Zm-98-550 97-101 59 57-100 96-56-52ZM154-212l101-97 55 53-97 101-59-57Zm326-268Z</Geometry>
        <Geometry x:Key="DarkIcon">M480-120q-150 0-255-105T120-480q0-150 105-255t255-105q14 0 27.5 1t26.5 3q-41 29-65.5 75.5T444-660q0 90 63 153t153 63q55 0 101-24.5t75-65.5q2 13 3 26.5t1 27.5q0 150-105 255T480-120Zm0-80q88 0 158-48.5T740-375q-20 5-40 8t-40 3q-123 0-209.5-86.5T364-660q0-20 3-40t8-40q-78 32-126.5 102T200-480q0 116 82 198t198 82Zm-10-270Z</Geometry>
    </hc:Window.Resources>

    <DockPanel>
        <!-- Общие настройки -->
        <StackPanel DockPanel.Dock="Top"
                    Orientation="Horizontal"
                    Margin="12,8">
            <hc:ButtonGroup HorizontalAlignment="Left"
                            VerticalAlignment="Bottom">
                <RadioButton IsChecked="{Binding Options.IsDark}"
                             hc:IconElement.Geometry="{StaticResource DarkIcon}"
                             hc:IconElement.Height="20"
                             hc:IconElement.Width="20" />
                <RadioButton IsChecked="True"
                             hc:IconElement.Geometry="{StaticResource LightIcon}"
                             hc:IconElement.Height="20"
                             hc:IconElement.Width="20" />
            </hc:ButtonGroup>

            <hc:ButtonGroup HorizontalAlignment="Left"
                            VerticalAlignment="Bottom"
                            Margin="8,0,0,0">
                <RadioButton Content="EN" IsChecked="{Binding Options.IsEnglish}" />
                <RadioButton Content="RU" IsChecked="{Binding Options.IsRussian}" />
            </hc:ButtonGroup>

            <hc:ButtonGroup HorizontalAlignment="Left"
                            VerticalAlignment="Bottom"
                            Margin="16,0,0,0">
                <ToggleButton Content="{loc:Text Options.SourceLineNumbers}"
                              IsChecked="{Binding Options.ShowSourceLineNumbers}" />
                <ToggleButton Content="{loc:Text Options.CodeLineNumbers}"
                              IsChecked="{Binding Options.ShowCodeLineNumbers}" />
                <ToggleButton Content="{loc:Text Options.Selection}"
                              IsChecked="{Binding Options.IsSelectionEnabled}" />
            </hc:ButtonGroup>
        </StackPanel>

        <!-- Витрины; номера строк в коде наследуются всеми вьюерами выбранной -->
        <TabControl Style="{StaticResource ShowcaseTabs}"
                    DockPanel.Dock="Bottom"
                    Margin="5,0"
                    ItemsSource="{Binding Showcases}"
                    SelectedItem="{Binding Selected}"
                    mdv:MarkdownViewer.ShowCodeLineNumbers="{Binding Options.ShowCodeLineNumbers}">
            <TabControl.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Title}" HorizontalAlignment="Left" />
                </DataTemplate>
            </TabControl.ItemTemplate>
        </TabControl>
    </DockPanel>
</hc:Window>