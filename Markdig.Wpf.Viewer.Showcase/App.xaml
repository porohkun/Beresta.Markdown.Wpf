<Application x:Class="MarkdigWpfViewer.Showcase.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:theming="clr-namespace:MarkdigWpfViewer.Showcase.Theming"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <hc:ThemeResources />
                <hc:Theme />
                <ResourceDictionary Source="pack://application:,,,/Markdig.Wpf.Viewer;component/Themes/Generic.xaml" />
                <!-- BYDESIGN: строго после словаря вьюера: он перекрывает его ключи -->
                <theming:ThemedResourceDictionary
                    Source="pack://application:,,,/Markdig.Wpf.Viewer.Showcase;component/Resources/MarkdownTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
