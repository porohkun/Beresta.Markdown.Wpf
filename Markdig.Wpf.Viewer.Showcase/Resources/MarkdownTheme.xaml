<!-- Ключи вьюера от цветов HandyControl -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- Подписи по-русски -->
    <sys:String x:Key="Md.ContextMenu.Copy">Копировать</sys:String>
    <sys:String x:Key="Md.ContextMenu.CopyMarkdown">Копировать как markdown</sys:String>
    <sys:String x:Key="Md.ContextMenu.SelectAll">Выделить всё</sys:String>
    <sys:String x:Key="Md.CodeBlock.CopyToolTip">Копировать код</sys:String>
    <sys:String x:Key="Md.Callout.Note.Title">Заметка</sys:String>
    <sys:String x:Key="Md.Callout.Tip.Title">Совет</sys:String>
    <sys:String x:Key="Md.Callout.Important.Title">Важно</sys:String>
    <sys:String x:Key="Md.Callout.Warning.Title">Предупреждение</sys:String>
    <sys:String x:Key="Md.Callout.Caution.Title">Осторожно</sys:String>
    <sys:String x:Key="Md.Details.Title">Подробности</sys:String>

    <!-- Текст и ссылки -->
    <SolidColorBrush x:Key="Md.Paragraph.Foreground" Color="{DynamicResource PrimaryTextColor}" />
    <SolidColorBrush x:Key="Md.Heading.Foreground" Color="{DynamicResource PrimaryTextColor}" />
    <SolidColorBrush x:Key="Md.Paragraph.LinkForeground" Color="{DynamicResource PrimaryColor}" />
    <SolidColorBrush x:Key="Md.Heading.LinkForeground" Color="{DynamicResource PrimaryColor}" />

    <!-- Код -->
    <SolidColorBrush x:Key="Md.InlineCode.Background" Color="{DynamicResource SecondaryRegionColor}" />
    <SolidColorBrush x:Key="Md.InlineCode.Foreground" Color="{DynamicResource DangerColor}" />
    <SolidColorBrush x:Key="Md.InlineCode.BorderBrush" Color="{DynamicResource BorderColor}" />
    <SolidColorBrush x:Key="Md.CodeBlock.Background" Color="{DynamicResource SecondaryRegionColor}" />
    <SolidColorBrush x:Key="Md.CodeBlock.Foreground" Color="{DynamicResource PrimaryTextColor}" />
    <SolidColorBrush x:Key="Md.CodeBlock.BorderBrush" Color="{DynamicResource BorderColor}" />
    <SolidColorBrush x:Key="Md.CodeBlock.LineNumberForeground" Color="{DynamicResource ThirdlyTextColor}" />
    <SolidColorBrush x:Key="Md.CodeBlock.HeaderForeground" Color="{DynamicResource ThirdlyTextColor}" />

    <!-- Клавиши, картинки, сноски -->
    <SolidColorBrush x:Key="Md.Kbd.Foreground" Color="{DynamicResource PrimaryTextColor}" />
    <SolidColorBrush x:Key="Md.Kbd.Background" Color="{DynamicResource SecondaryRegionColor}" />
    <SolidColorBrush x:Key="Md.Kbd.BorderBrush" Color="{DynamicResource BorderColor}" />
    <SolidColorBrush x:Key="Md.Image.AltForeground" Color="{DynamicResource ThirdlyTextColor}" />
    <SolidColorBrush x:Key="Md.Footnote.MarkerForeground" Color="{DynamicResource ThirdlyTextColor}" />

    <!-- Маркер, подпись фигуры, подвал -->
    <SolidColorBrush x:Key="Md.Marked.Background" Color="{DynamicResource WarningColor}" Opacity="0.35" />
    <SolidColorBrush x:Key="Md.Figure.CaptionForeground" Color="{DynamicResource ThirdlyTextColor}" />
    <SolidColorBrush x:Key="Md.Footer.Foreground" Color="{DynamicResource ThirdlyTextColor}" />

    <!-- Поля с номерами строк -->
    <SolidColorBrush x:Key="Md.Gutter.Foreground" Color="{DynamicResource ThirdlyTextColor}" />

    <!-- Цитата и таблица -->
    <SolidColorBrush x:Key="Md.Quote.BorderBrush" Color="{DynamicResource PrimaryColor}" />
    <SolidColorBrush x:Key="Md.Table.BorderBrush" Color="{DynamicResource BorderColor}" />
    <SolidColorBrush x:Key="Md.Table.HeaderBackground" Color="{DynamicResource SecondaryRegionColor}" />

    <!-- Плашки и сворачиваемые блоки -->
    <SolidColorBrush x:Key="Md.Callout.Note.Brush" Color="{DynamicResource PrimaryColor}" />
    <SolidColorBrush x:Key="Md.Callout.Tip.Brush" Color="{DynamicResource SuccessColor}" />
    <SolidColorBrush x:Key="Md.Callout.Important.Brush" Color="{DynamicResource VioletColor}" />
    <SolidColorBrush x:Key="Md.Callout.Warning.Brush" Color="{DynamicResource WarningColor}" />
    <SolidColorBrush x:Key="Md.Callout.Caution.Brush" Color="{DynamicResource DangerColor}" />
    <SolidColorBrush x:Key="Md.Details.MarkerForeground" Color="{DynamicResource SecondaryTextColor}" />

</ResourceDictionary>