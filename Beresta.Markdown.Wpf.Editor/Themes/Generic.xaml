<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                    xmlns:local="clr-namespace:Beresta.Markdown.Wpf.Editor">

    <!-- Тема редактора: вливается в ресурсы приложения после темы вьюера. Остальной вид исходника берёт ключи вьюера -->
    <Brush x:Key="Md.Source.Markup.Foreground">#8C959F</Brush>
    <Brush x:Key="Md.Source.Background">#0A8C959F</Brush>

    <!-- ======== Md.Source.ContextMenu: меню исходника; в отрисовке остаётся меню вьюера ======== -->
    <sys:String x:Key="Md.Source.ContextMenu.Cut">Cut</sys:String>
    <sys:String x:Key="Md.Source.ContextMenu.Copy">Copy</sys:String>
    <sys:String x:Key="Md.Source.ContextMenu.Paste">Paste</sys:String>
    <sys:String x:Key="Md.Source.ContextMenu.PasteFormatted">Paste with formatting</sys:String>
    <sys:String x:Key="Md.Source.ContextMenu.SelectAll">Select all</sys:String>
    <ContextMenu x:Key="Md.Source.ContextMenu" x:Shared="False">
        <MenuItem Header="{DynamicResource Md.Source.ContextMenu.Cut}"
                  Command="ApplicationCommands.Cut"
                  CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}" />
        <MenuItem Header="{DynamicResource Md.Source.ContextMenu.Copy}"
                  Command="ApplicationCommands.Copy"
                  CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}" />
        <MenuItem Header="{DynamicResource Md.Source.ContextMenu.Paste}"
                  Command="ApplicationCommands.Paste"
                  CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}" />
        <MenuItem Header="{DynamicResource Md.Source.ContextMenu.PasteFormatted}"
                  Command="{x:Static local:MarkdownEditor.PasteFormattedCommand}"
                  CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}" />
        <Separator />
        <MenuItem Header="{DynamicResource Md.Source.ContextMenu.SelectAll}"
                  Command="ApplicationCommands.SelectAll"
                  CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}" />
    </ContextMenu>

</ResourceDictionary>
