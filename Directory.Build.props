<Project>

	<PropertyGroup>
		<LangVersion>14</LangVersion>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<UseWPF>true</UseWPF>
		<CheckEolTargetFramework>false</CheckEolTargetFramework>
	</PropertyGroup>

	<!-- Version of both packages -->
	<PropertyGroup>
		<VersionPrefix>0.8.0</VersionPrefix>
	</PropertyGroup>

</Project>