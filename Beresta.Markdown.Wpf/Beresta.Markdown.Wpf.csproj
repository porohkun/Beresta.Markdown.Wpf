<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net7.0-windows;net8.0-windows;net9.0-windows;net10.0-windows</TargetFrameworks>
		<RootNamespace>Beresta.Markdown.Wpf</RootNamespace>
	</PropertyGroup>

	<!-- Documentation -->
	<PropertyGroup>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<WarningsAsErrors>$(WarningsAsErrors);CS1591</WarningsAsErrors>
	</PropertyGroup>

	<!-- Package -->
	<PropertyGroup>
		<IsPackable>true</IsPackable>
		<PackageId>Beresta.Markdown.Wpf</PackageId>
		<Title>Beresta.Markdown.Wpf</Title>
		<Authors>Porohkun</Authors>
		<Copyright>Copyright (c) 2026 Pavel</Copyright>
		<Description>Fast native Markdown viewer for WPF, no browser or FlowDocument: virtualized for huge documents, live updates for previews and streamed answers, selection across blocks, themeable and extensible. On Markdig.</Description>
		<PackageIcon>icon512.png</PackageIcon>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageProjectUrl>https://github.com/porohkun/Beresta.Markdown.Wpf</PackageProjectUrl>
		<RepositoryUrl>https://github.com/porohkun/Beresta.Markdown.Wpf</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageTags>markdown;wpf;xaml;viewer;renderer;control;markdig;commonmark;gfm;chat;obsidian</PackageTags>
		<PublishRepositoryUrl>true</PublishRepositoryUrl>
		<EmbedUntrackedSources>true</EmbedUntrackedSources>
		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
	</PropertyGroup>

	<ItemGroup>
		<None Include="..\README.md" Pack="true" PackagePath="\" Visible="false" />
		<None Include="..\icon512.png" Pack="true" PackagePath="\" Visible="false" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Markdig" Version="1.1.3" />
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="Beresta.Markdown.Wpf.Tests" />
	</ItemGroup>

	<Import Project="..\build\Documentation.targets" />

</Project>
