<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<RootNamespace>Beresta.Markdown.Wpf</RootNamespace>
	</PropertyGroup>

	<!-- Package -->
	<PropertyGroup>
		<IsPackable>true</IsPackable>
		<PackageId>Beresta.Markdown.Wpf</PackageId>
		<Version>0.6.0</Version>
		<AssemblyVersion>0.6.0.0</AssemblyVersion>
		<FileVersion>0.6.0.0</FileVersion>
		<InformationalVersion>0.6.0</InformationalVersion>
		<Authors>Porohkun</Authors>
		<Description>Markdown viewer for WPF based on Markdig.</Description>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageProjectUrl>https://github.com/porohkun/Beresta.Markdown.Wpf</PackageProjectUrl>
		<RepositoryUrl>https://github.com/porohkun/Beresta.Markdown.Wpf</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageTags>markdown;wpf;markdig</PackageTags>

		<SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Markdig" Version="1.1.3" />
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="Beresta.Markdown.Wpf.Tests" />
	</ItemGroup>

</Project>